binder_use(hal_misys_default)
get_prop(hal_misys_default, vendor_camera_sensor_prop)
dontaudit hal_misys_default boot_status_prop:file r_file_perms;
dontaudit hal_misys_default device:chr_file rw_file_perms;

allow hal_misys_default platform_app:binder transfer;
allow hal_misys_default kmsg_device:chr_file r_file_perms;
