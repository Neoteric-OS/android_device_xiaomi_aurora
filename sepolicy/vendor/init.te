# Battery
allow init vendor_sysfs_qcom_battery:file { open };

# Touchfeature

allow init same_process_hal_file:file { execute };
allow init self:qipcrtr_socket { create getattr setopt write read };

# Vibrator
allow init vendor_sysfs_vibrator:file create_file_perms;

# Allow camera provider writepid to /sys/kernel/reserve_pool/pid.
allow init sysfs_camera_reserve_pool:file w_file_perms;
