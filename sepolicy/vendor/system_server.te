# Audio
allow system_server audioserver_tmpfs:file { write };

# Camera
get_prop(system_server, camera2_extensions_prop)

# Fingerprint
allow system_server vendor_hal_fingerprint_hwservice_xiaomi:hwservice_manager { add find };
get_prop(system_server, vendor_fp_prop)

# MiCharge
allow system_server vendor_hal_micharge_xiaomi_service:service_manager find;

# Mlipay
allow system_server hal_mtdservice_service:service_manager find;

# SLA
allow system_server hal_slaservice_hwservice:hwservice_manager find;
allow system_server hal_slaservice_qti:binder call;

# SnapdragonServices (no HAL on this platform, libtrigger-handler polls it)
type vendor_hal_snapx_service, service_manager_type;
dontaudit system_server vendor_hal_snapx_service:service_manager find;
