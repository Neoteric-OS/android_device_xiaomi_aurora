allow hal_mtdservice_default hal_mtdservice_service:service_manager add;
allow hal_mtdservice_default hal_mlipay_service:service_manager find;
allow hal_mtdservice_default hal_mfidoca_service:service_manager find;
allow hal_mtdservice_default platform_app:binder transfer;
allow hal_mtdservice_default self:qipcrtr_socket { read create getattr write setopt };
get_prop(hal_mtdservice_default, vendor_cpuid_prop)
set_prop(hal_mtdservice_default, vendor_system_prop)
add_service(hal_mtdservice_server, hal_mtdservice_service)
dontaudit hal_mtdservice_default serialno_prop:file { r_file_perms };
