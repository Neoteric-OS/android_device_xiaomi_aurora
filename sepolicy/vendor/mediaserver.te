allow mediaserver vendor_hal_ozonotify_service:service_manager find;
allow mediaserver vendor_hal_ozonotify_hwservice:hwservice_manager find;
allow mediaserver vendor_hal_ozonotify:binder { call transfer };
allow mediaserver vendor_hal_ozonotify:fd *;
allow mediaserver vendor_hal_ozonotify_default:binder call;

get_prop(mediaserver, vendor_display_prop)
