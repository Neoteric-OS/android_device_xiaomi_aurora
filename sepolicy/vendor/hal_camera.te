allow hal_camera_client hal_aidlbgservice_service:service_manager find;
allow hal_camera_default proc_mv:file r_file_perms;
allow hal_camera_default self:capability sys_resource;
allow hal_camera_default self:capability ipc_lock;
allow hal_camera_default platform_app:binder transfer;
allow hal_camera_default platform_app:binder { call transfer };
allow hal_camera_default platform_app:fd *;
allow hal_camera_default vendor_displayfeature_device:chr_file { read };
allow hal_camera_default vendor_sysfs_displayfeature:dir search;
allow hal_camera_default vendor_sysfs_displayfeature:file { read open };
allow hal_camera_default vendor_sysfs_kgsl:lnk_file read;

# Allow the MiAlgo/MAW framework to read the SoC id
get_prop(hal_camera_default, vendor_soc_id_prop)

add_service(hal_camera_server, hal_aidlbgservice_service)

# QuickCamera AIDL
hal_server_domain(hal_camera_default, hal_quickcamera)

allow hal_camera_default vendor_sysfs_kgsl_proc:dir search;
